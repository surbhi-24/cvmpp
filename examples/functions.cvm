// functions.cvm — recursive factorial and fibonacci

func factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

func fib(n) {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

print(factorial(10));   // 3628800
print(fib(10));         // 55
